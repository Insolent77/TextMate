{
  "manifest_version": 3,
  "name": "TextMate",
  "version": "0.8.1",
  "description": "AI-инструменты для выделенного текста: локальный Ollama или облачные провайдеры, перевод, редактирование и адаптеры онлайн-редакторов.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TextMate",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "compat.js",
        "content/runtime.js",
        "content/adapters.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}